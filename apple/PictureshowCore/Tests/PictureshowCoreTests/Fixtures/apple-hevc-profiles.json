{
  "schemaVersion": 1,
  "platform": "AVFoundation",
  "contract": "Native exception: baseline Direct stays exact; a qualified HLS-only request adds bounded HEVC/fMP4 and keeps AVC/TS. Android Media3 shared profile vectors are unchanged.",
  "cases": [
    {
      "id": "unknown-tuple-retains-accepted-avc",
      "input": {
        "supportsHEVC": true
      },
      "expected": {
        "Name": "Pictureshow Apple",
        "MaxStreamingBitrate": 200000000,
        "MaxStaticBitrate": 200000000,
        "DirectPlayProfiles": [
          {
            "Container": "mp4,m4v,mov",
            "Type": "Video",
            "VideoCodec": "h264,hevc",
            "AudioCodec": "aac,mp3,alac,ac3,eac3"
          }
        ],
        "TranscodingProfiles": [
          {
            "Container": "ts",
            "Type": "Video",
            "VideoCodec": "h264",
            "AudioCodec": "aac",
            "Protocol": "hls",
            "Context": "Streaming",
            "MaxAudioChannels": "2",
            "MinSegments": 2,
            "SegmentLength": 6,
            "EnableSubtitlesInManifest": false,
            "BreakOnNonKeyFrames": false
          }
        ],
        "CodecProfiles": [
          {
            "Type": "Video",
            "Codec": "h264",
            "Conditions": [
              {
                "Condition": "LessThanEqual",
                "Property": "VideoBitDepth",
                "Value": "8",
                "IsRequired": false
              },
              {
                "Condition": "EqualsAny",
                "Property": "VideoProfile",
                "Value": "high|main|baseline|constrained baseline",
                "IsRequired": false
              },
              {
                "Condition": "LessThanEqual",
                "Property": "Width",
                "Value": "1920",
                "IsRequired": false
              },
              {
                "Condition": "LessThanEqual",
                "Property": "Height",
                "Value": "1080",
                "IsRequired": false
              },
              {
                "Condition": "EqualsAny",
                "Property": "VideoRangeType",
                "Value": "SDR",
                "IsRequired": false
              }
            ]
          },
          {
            "Type": "Video",
            "Codec": "hevc",
            "Conditions": [
              {
                "Condition": "LessThanEqual",
                "Property": "VideoBitDepth",
                "Value": "10",
                "IsRequired": false
              },
              {
