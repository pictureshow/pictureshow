{
  "schemaVersion": 1,
  "suite": "queue-order",
  "cases": [
    {
      "id": "queue-order.wrap-starts-new-shuffle-traversal",
      "operation": "queue",
      "state": {
        "server": "s",
        "viewer": "v",
        "entries": [
          {
            "id": "a",
            "media": "track",
            "downloaded": true
          },
          {
            "id": "b",
            "media": "track",
            "downloaded": true
          },
          {
            "id": "c",
            "media": "c",
            "downloaded": true
          }
        ],
        "order": [
          "a",
          "c",
          "b"
        ],
        "current": "b",
        "positionTicks": "0",
        "paused": false,
        "history": [
          "a",
          "c"
        ],
        "visited": [
          "a",
          "c"
        ],
        "shuffled": true,
        "repeat": "all"
      },
      "steps": [
        {
          "event": {
            "op": "next",
            "revision": "0"
          },
          "expected": {
            "queue": {
              "current": "a",
              "visited": [],
              "history": [
                "a",
                "c",
                "b"
              ],
              "completion": "1"
            },
            "outcome": "changed"
          }
        },
        {
          "event": {
            "op": "unshuffle",
            "revision": "1"
          },
          "expected": {
            "queue": {
              "order": [
                "a",
                "b",
                "c"
              ],
              "current": "a",
              "visited": [],
              "history": [
                "a",
                "c",
                "b"
              ]
            },
            "outcome": "changed"
          }
        },
        {
          "event": {
            "op": "previous",
            "revision": "2"
          },
          "expected": {
            "queue": {
              "current": "b",
              "history": [
                "a",
                "c"
              ],
              "visited": [
                "a"
              ],
              "positionTicks": "0",
              "completion": "2"
            },
            "outcome": "changed"
          }
        },
        {
          "event": {
            "op": "next",
            "revision": "3",
            "completion": "2"
          },
          "expected": {
            "queue": {
              "current": "c",
              "visited": [
                "a",
                "b"
              ],
              "history": [
                "a",
                "c",
                "b"
              ]
            },
            "outcome": "changed"
          }
        }
      ]
    },
