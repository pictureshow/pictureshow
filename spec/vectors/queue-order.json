        },
        {
          "event": {
            "op": "error",
            "revision": "1",
            "music": true,
            "completion": "1"
          },
          "expected": {
            "queue": {
              "current": "c",
              "failed": [
                "a",
                "b"
              ],
              "completion": "2"
            },
            "outcome": "skipped-unavailable"
          }
        },
        {
          "event": {
            "op": "error",
            "revision": "2",
            "music": true,
            "completion": "2"
          },
          "expected": {
            "queue": {
              "current": "c",
              "failed": [
                "a",
                "b",
                "c"
              ],
              "paused": true,
              "completion": "3"
            },
            "outcome": "exhausted"
          }
        },
        {
          "event": {
            "op": "error",
            "revision": "3",
            "music": true,
            "completion": "2"
          },
          "expected": {
            "outcome": "duplicate-completion",
            "queue": {
              "completion": "3"
            }
          }
        },
        {
          "event": {
            "op": "retry",
            "revision": "3"
          },
          "expected": {
            "queue": {
              "current": "c",
              "failed": [],
              "paused": false
            },
            "outcome": "changed"
          }
        }
      ]
