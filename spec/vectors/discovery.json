          }
        ],
        "remote": [
          {
            "Url": "https://www.youtube.com/watch?v=HOfdboHvshg"
          },
          {
            "Url": "https://youtu.be/HOfdboHvshg",
            "Name": "Same video"
          },
          {
            "Url": "https://example.org/trailer.mp4",
            "Name": " Teaser "
          },
          {
            "Url": "javascript:alert(1)"
          },
          {
            "Url": ""
          },
          {
            "Name": "No address"
          },
          {
            "Url": "https://example.org/trailer.mp4"
          }
        ]
      },
      "expected": [
        {
          "key": "local:t1",
          "title": "Sintel Trailer",
          "itemId": "t1",
          "url": null,
          "youTubeId": null
        },
        {
          "key": "local:t2",
          "title": "Trailer",
          "itemId": "t2",
          "url": null,
          "youTubeId": null
        },
        {
          "key": "remote:HOfdboHvshg",
          "title": "Trailer 2",
          "itemId": null,
          "url": "https://www.youtube.com/watch?v=HOfdboHvshg",
          "youTubeId": "HOfdboHvshg"
        },
        {
          "key": "remote:https://example.org/trailer.mp4",
