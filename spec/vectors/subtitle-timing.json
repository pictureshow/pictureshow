{
  "schemaVersion": 1,
  "suite": "subtitle-timing",
  "source": "PLAY-11; core SubtitleTiming; SubtitleTimingVectorsTest",
  "cases": [
    {
      "id": "play-11.label-zero",
      "operation": "label",
      "input": {
        "ms": 0
      },
      "expected": "Timing: in sync"
    },
    {
      "id": "play-11.label-later",
      "operation": "label",
      "input": {
        "ms": 300
      },
      "expected": "Timing: +300 ms (later)"
    },
    {
      "id": "play-11.label-earlier-grouped",
      "operation": "label",
      "input": {
        "ms": -1200
      },
      "expected": "Timing: −1,200 ms (earlier)"
    },
    {
      "id": "play-11.label-limit",
      "operation": "label",
      "input": {
        "ms": 10000
      },
      "expected": "Timing: +10,000 ms (later)"
    },
    {
      "id": "play-11.label-off-grid-normalized",
      "operation": "label",
      "input": {
        "ms": 250
      },
      "expected": "Timing: +200 ms (later)"
    },
    {
      "id": "play-11.step-later",
      "operation": "step",
      "input": {
        "ms": 0,
        "direction": 1
      },
      "expected": 100
    },
    {
      "id": "play-11.step-earlier",
      "operation": "step",
      "input": {
        "ms": 0,
        "direction": -1
      },
      "expected": -100
    },
    {
      "id": "play-11.step-clamps-later",
      "operation": "step",
      "input": {
        "ms": 10000,
        "direction": 1
      },
      "expected": 10000
    },
    {
      "id": "play-11.step-clamps-earlier",
      "operation": "step",
      "input": {
        "ms": -10000,
        "direction": -1
      },
      "expected": -10000
    },
    {
      "id": "play-11.step-off-grid",
      "operation": "step",
      "input": {
        "ms": -150,
        "direction": 1
      },
      "expected": 0
    },
    {
      "id": "play-11.can-step-at-limit",
      "operation": "can-step",
      "input": {
        "ms": 10000,
        "direction": 1
      },
      "expected": false
    },
    {
      "id": "play-11.can-step-below-limit",
      "operation": "can-step",
      "input": {
        "ms": 9900,
        "direction": 1
      },
      "expected": true
    },
    {
      "id": "play-11.can-step-earlier-at-limit",
      "operation": "can-step",
      "input": {
        "ms": -10000,
        "direction": -1
      },
      "expected": false
    },
    {
      "id": "play-11.normalize-out-of-range",
      "operation": "normalize",
      "input": {
        "ms": -25000
      },
      "expected": -10000
    },
    {
      "id": "play-11.section-off",
      "operation": "section",
      "input": {
        "subtitleOn": false,
        "burnedIn": false
      },
      "expected": "Hidden"
    },
    {
      "id": "play-11.section-off-even-if-burned",
      "operation": "section",
      "input": {
        "subtitleOn": false,
        "burnedIn": true
      },
      "expected": "Hidden"
    },
    {
      "id": "play-11.section-burned-in",
      "operation": "section",
      "input": {
        "subtitleOn": true,
        "burnedIn": true
      },
      "expected": "BurnedIn"
    },
    {
      "id": "play-11.section-controls",
      "operation": "section",
      "input": {
        "subtitleOn": true,
        "burnedIn": false
      },
      "expected": "Controls"
    },
    {
      "id": "play-11.help",
      "operation": "help",
      "input": {},
      "expected": "Use Later if captions appear too early."
    },
    {
      "id": "play-11.burned-in-line",
      "operation": "burned-in",
      "input": {},
      "expected": "These subtitles are encoded into the video. Timing and appearance cannot be changed."
    }
  ]
}
