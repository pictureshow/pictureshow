{
  "schemaVersion": 1,
  "suite": "sync-tv-surfaces",
  "cases": [
    {
      "id": "create-visible-focus-default",
      "profile": "create-focus",
      "input": {
        "draft": "Friday films",
        "fontScale": 1.0,
        "theme": {
          "kind": "default"
        }
      },
      "expected": {
        "focusMarkMinThicknessDp": 2,
        "focusMarkMinContrast": 3.0,
        "focusMarkBandWidthFraction": 0.7,
        "focusMarkChangedWidthFraction": 0.8,
        "focusProbeRadiusDp": 4,
        "stableBounds": true
      }
    },
    {
      "id": "create-visible-focus-alternate",
      "profile": "create-focus",
      "input": {
        "draft": "Friday films",
        "fontScale": 1.0,
        "theme": {
          "kind": "alternate",
          "primary": "FF6ADDC4",
          "onPrimary": "FF00382E",
          "surface": "FF111A18",
          "onSurface": "FFEAFFF5"
        }
      },
      "expected": {
        "focusMarkMinThicknessDp": 2,
        "focusMarkMinContrast": 3.0,
        "focusMarkBandWidthFraction": 0.7,
        "focusMarkChangedWidthFraction": 0.8,
        "focusProbeRadiusDp": 4,
        "stableBounds": true
      }
    },
