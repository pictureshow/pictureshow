{
  "schemaVersion": 1,
  "suite": "search-presentation",
  "cases": [
    {
      "id": "same-title-year",
      "operation": "search-duplicate-ids",
      "input": {
        "items": [
          {
            "Id": "a",
            "Name": "Cloud",
            "Type": "Movie",
            "ProductionYear": 2026
          },
          {
            "Id": "b",
            "Name": "Cloud",
            "Type": "Movie",
            "ProductionYear": 2026
          }
        ]
      },
      "expected": [
        "a",
        "b"
      ]
    },
    {
      "id": "same-title-different-year",
      "operation": "search-duplicate-ids",
      "input": {
        "items": [
          {
            "Id": "a",
            "Name": "Cloud",
            "Type": "Movie",
            "ProductionYear": 2026
          },
          {
            "Id": "b",
            "Name": "Cloud",
            "Type": "Movie",
            "ProductionYear": 2025
          }
        ]
      },
      "expected": []
    },
    {
      "id": "normalized-title",
      "operation": "search-duplicate-ids",
      "input": {
        "items": [
          {
            "Id": "a",
            "Name": "Cloud",
            "Type": "Movie",
            "ProductionYear": 2026
