      "id": "ancestor-library-fallback",
      "operation": "search-library-name",
      "input": {
        "ancestors": [
          {
            "Id": "open",
            "Name": "Open Movies",
            "Type": "CollectionFolder",
            "ProductionYear": 2026
          }
        ],
        "libraries": []
      },
      "expected": "Open Movies"
