{
  "schemaVersion": 1,
  "suite": "sync-stay",
  "rule": "SYN-08: closing the player keeps membership; only explicit Leave, an external route, sign-out or the server removes it.",
  "cases": [
    {
      "id": "sync-stay.close.back-stays-and-stops-holding-the-wait",
      "op": "close",
      "input": {
        "reason": "BACK",
        "participating": true,
        "following": true
      },
      "expected": {
        "outcome": "STAY",
        "ignoreWait": true,
        "departure": null
      }
    },
    {
      "id": "sync-stay.close.close-button-stays-and-stops-holding-the-wait",
      "op": "close",
      "input": {
        "reason": "CLOSE",
        "participating": true,
        "following": true
      },
      "expected": {
        "outcome": "STAY",
        "ignoreWait": true,
        "departure": null
      }
    },
    {
      "id": "sync-stay.close.stop-button-stays-and-stops-holding-the-wait",
      "op": "close",
      "input": {
        "reason": "STOP_BUTTON",
        "participating": true,
        "following": true
      },
      "expected": {
        "outcome": "STAY",
        "ignoreWait": true,
        "departure": null
      }
    },
    {
      "id": "sync-stay.close.error-back-stays-and-stops-holding-the-wait",
      "op": "close",
      "input": {
        "reason": "ERROR_BACK",
        "participating": true,
        "following": true
      },
      "expected": {
        "outcome": "STAY",
        "ignoreWait": true,
        "departure": null
      }
    },
    {
      "id": "sync-stay.close.natural-end-stays-and-stops-holding-the-wait",
      "op": "close",
      "input": {
        "reason": "NATURAL_END",
        "participating": true,
        "following": true
      },
      "expected": {
        "outcome": "STAY",
        "ignoreWait": true,
        "departure": null
      }
    },
    {
      "id": "sync-stay.close.back-after-earlier-stay-sends-nothing-new",
      "op": "close",
      "input": {
        "reason": "BACK",
        "participating": true,
        "following": false
      },
      "expected": {
        "outcome": "STAY",
        "ignoreWait": false,
        "departure": null
      }
    },
    {
      "id": "sync-stay.close.not-participating-is-untouched",
      "op": "close",
      "input": {
        "reason": "BACK",
        "participating": false,
        "following": true
      },
      "expected": {
        "outcome": "NONE",
        "ignoreWait": false,
        "departure": null
      }
    },
    {
      "id": "sync-stay.close.background-on-home-keeps-membership",
      "op": "close",
      "input": {
        "reason": "BACKGROUND_IDLE",
        "participating": true,
        "following": false
      },
      "expected": {
        "outcome": "STAY",
        "ignoreWait": false,
        "departure": null
      }
    },
    {
      "id": "sync-stay.close.background-while-rendering-keeps-leave-once",
      "op": "close",
      "input": {
        "reason": "BACKGROUND_RENDERING",
        "participating": true,
        "following": true
      },
      "expected": {
        "outcome": "LEAVE",
        "ignoreWait": false,
        "departure": "MEMBERSHIP_LOST"
      }
    },
    {
      "id": "sync-stay.close.cast-handoff-leaves",
      "op": "close",
      "input": {
        "reason": "EXTERNAL_ROUTE",
        "participating": true,
        "following": true
      },
      "expected": {
        "outcome": "LEAVE",
        "ignoreWait": false,
        "departure": "EXTERNAL_ROUTE"
      }
    },
    {
      "id": "sync-stay.close.explicit-leave-leaves",
      "op": "close",
      "input": {
        "reason": "MANUAL_LEAVE",
        "participating": true,
        "following": false
      },
      "expected": {
        "outcome": "LEAVE",
        "ignoreWait": false,
        "departure": "MANUAL_LEAVE"
      }
    },
    {
      "id": "sync-stay.close.sign-out-leaves-without-a-retained-fact",
      "op": "close",
      "input": {
        "reason": "SIGN_OUT",
        "participating": true,
        "following": false
      },
      "expected": {
        "outcome": "LEAVE",
        "ignoreWait": false,
        "departure": null
      }
    },
    {
      "id": "sync-stay.reminder.stayed-with-queue-offers-watch-and-leave",
