{
  "schemaVersion": 1,
  "suite": "music-offline",
  "cases": [
    {
      "id": "music-offline.nothing-downloaded-pauses-as-before",
      "operation": "unreachable",
      "input": {
        "queue": {
          "server": "s",
          "viewer": "v",
          "entries": [
            {
              "id": "a",
              "media": "m-a"
            },
            {
              "id": "b",
              "media": "m-b"
            }
          ],
          "current": "a",
          "repeat": "off",
          "paused": false,
          "order": [
            "a",
            "b"
          ]
        },
        "local": [],
        "title": "Song A"
      },
      "expected": {
        "step": "pause",
        "message": "Can't reach the server. Your queue is saved: press Play to try again."
      }
    },
