{
  "schemaVersion": 1,
  "suite": "remote-queue",
  "cases": [
    {
      "id": "remote-queue.movie-added-to-an-episode-plays-before-the-series",
      "operation": "queue",
      "state": {
        "queue": {
          "server": "s",
          "viewer": "v"
        }
      },
      "steps": [
        {
          "event": {
            "op": "open",
            "items": [
              "e1",
              "e2",
              "e3"
            ]
          },
          "expected": {
            "current": "e1",
            "upNext": [
              "e2",
              "e3"
            ]
          }
        },
        {
          "event": {
            "op": "add-last",
            "items": [
              "m"
            ],
            "watching": "e1"
          },
          "expected": {
            "current": "e1",
            "upNext": [
              "m",
              "e2",
              "e3"
            ]
          }
        },
        {
          "event": {
            "op": "add-last",
            "items": [
              "n"
            ],
            "watching": "e1"
          },
          "expected": {
            "current": "e1",
            "upNext": [
              "m",
              "n",
              "e2",
              "e3"
            ]
          }
        }
      ]
    },
