    {
      "id": "cast-capability.transcode-is-hls",
      "operation": "media",
      "state": {},
      "steps": [
        {
          "event": {
            "serverUrl": "http://server.example/jf",
            "itemId": "i",
            "token": "t",
            "method": "Transcode",
            "url": "http://server.example/jf/videos/i/master.m3u8?MediaSourceId=src",
            "source": {
              "Id": "src",
              "Container": "mkv"
            }
          },
          "expected": {
            "url": "http://server.example/jf/videos/i/master.m3u8?MediaSourceId=src&ApiKey=t",
            "contentType": "application/x-mpegURL",
            "subtitles": []
          }
        }
      ]
