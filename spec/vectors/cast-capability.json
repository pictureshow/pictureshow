    {
      "id": "cast-capability.unavailable-track-can-not-read-as-selected",
      "operation": "controls",
      "state": {},
      "steps": [
        {
          "event": {
            "commands": [
              "tracks"
            ],
            "tracks": [
              {
                "id": 4,
                "type": "subtitle",
                "label": "English"
              },
              {
                "id": 5,
                "type": "subtitle",
                "label": "Forced",
                "available": false
              }
            ],
            "activeTracks": [
              5
            ]
          },
          "expected": {
            "tracks": [
              {
                "id": 4,
                "type": "subtitle",
                "label": "English",
                "selectable": true,
                "selected": false
              },
              {
                "id": 5,
                "type": "subtitle",
                "label": "Forced",
                "selectable": false,
                "selected": false
              }
            ]
          }
        }
      ]
    },
