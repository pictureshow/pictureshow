      "id": "cast-capability.vod-with-everything",
      "operation": "controls",
      "state": {},
      "steps": [
        {
          "event": {
            "commands": [
              "pause",
              "seek",
              "stop",
              "volume",
              "tracks"
            ],
            "durationTicks": "72000000000"
          },
          "expected": {
            "pause": true,
            "seek": true,
            "stop": true,
            "volume": true,
            "volumeReason": null,
            "timeline": "vod",
            "seekStartTicks": "0",
