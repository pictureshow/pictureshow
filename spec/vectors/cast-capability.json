    {
      "id": "cast-capability.direct-media-carries-the-token-for-the-receiver-only",
      "operation": "media",
      "state": {},
      "steps": [
        {
          "event": {
            "serverUrl": "http://server.example/jf",
            "itemId": "i",
            "token": "t k",
            "method": "DirectPlay",
            "url": "http://server.example/jf/Videos/i/stream?static=true&ApiKey=old",
            "source": {
              "Id": "src",
              "Container": "mp4",
              "MediaStreams": [
                {
                  "Type": "Subtitle",
                  "Index": 3,
                  "IsTextSubtitleStream": true,
                  "DisplayTitle": "English",
                  "Language": "eng",
                  "Codec": "srt"
                },
                {
                  "Type": "Subtitle",
                  "Index": 4,
                  "IsTextSubtitleStream": false,
                  "DisplayTitle": "Forced",
                  "Codec": "pgssub"
                },
                {
                  "Type": "Video",
                  "Index": 0,
                  "Codec": "h264"
                }
              ]
            }
          },
          "expected": {
            "url": "http://server.example/jf/Videos/i/stream?static=true&ApiKey=t%20k",
            "contentType": "video/mp4",
            "subtitles": [
              {
                "trackId": 4,
                "streamIndex": 3,
                "label": "English",
                "language": "eng",
                "url": "http://server.example/jf/Videos/i/src/Subtitles/3/0/Stream.vtt?ApiKey=t%20k"
              }
            ]
          }
        }
      ]
