{
  "schemaVersion": 1,
  "suite": "music-reports",
  "cases": [
    {
      "id": "music-reports.one-track-one-start-one-stop",
      "operation": "report",
      "state": {},
      "steps": [
        {
          "event": {
            "op": "load",
            "entry": "a",
            "media": "x"
          },
          "expected": {
            "effects": []
          }
        },
        {
          "event": {
            "op": "playing",
            "ticks": "0"
          },
          "expected": {
            "effects": [
              {
                "report": "start",
                "media": "x",
                "serial": "1",
                "ticks": "0",
                "paused": false,
                "failed": false
              }
            ]
          }
        },
        {
          "event": {
            "op": "ended",
            "ticks": "100"
          },
          "expected": {
            "effects": [
              {
                "report": "stopped",
                "media": "x",
                "serial": "1",
                "ticks": "100",
                "paused": false,
                "failed": false
              }
            ]
          }
        },
        {
          "event": {
            "op": "ended",
            "ticks": "100"
          },
          "expected": {
            "effects": []
          }
        }
      ]
    },
    {
      "id": "music-reports.same-song-twice-is-two-viewings",
      "operation": "report",
      "state": {},
      "steps": [
        {
          "event": {
            "op": "load",
            "entry": "a",
            "media": "x"
          },
          "expected": {
            "effects": []
          }
        },
        {
          "event": {
            "op": "playing"
          },
          "expected": {
            "effects": [
              {
                "report": "start",
                "media": "x",
                "serial": "1",
                "ticks": "0",
                "paused": false,
                "failed": false
              }
            ]
          }
        },
        {
          "event": {
            "op": "load",
            "entry": "b",
            "media": "x",
            "ticks": "9"
          },
          "expected": {
            "effects": [
              {
                "report": "stopped",
                "media": "x",
                "serial": "1",
                "ticks": "9",
                "paused": false,
                "failed": false
              }
            ]
          }
        },
        {
          "event": {
            "op": "playing"
          },
          "expected": {
            "effects": [
              {
                "report": "start",
                "media": "x",
                "serial": "2",
                "ticks": "0",
                "paused": false,
                "failed": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": "music-reports.repeat-one-is-a-new-viewing",
      "operation": "report",
      "state": {},
      "steps": [
        {
          "event": {
            "op": "load",
            "entry": "a",
            "media": "x"
          },
          "expected": {
            "effects": []
          }
        },
        {
          "event": {
            "op": "playing"
          },
          "expected": {
            "effects": [
              {
                "report": "start",
                "media": "x",
                "serial": "1",
                "ticks": "0",
                "paused": false,
                "failed": false
              }
            ]
          }
        },
        {
          "event": {
            "op": "load",
            "entry": "a",
            "media": "x",
            "ticks": "9"
          },
          "expected": {
            "effects": [
              {
                "report": "stopped",
                "media": "x",
                "serial": "1",
                "ticks": "9",
                "paused": false,
                "failed": false
              }
            ],
            "viewing": {
              "entry": "a",
              "serial": "2",
              "started": false
            }
          }
        },
        {
          "event": {
            "op": "playing"
          },
          "expected": {
            "effects": [
              {
                "report": "start",
                "media": "x",
                "serial": "2",
                "ticks": "0",
                "paused": false,
                "failed": false
              }
            ]
          }
        }
      ]
