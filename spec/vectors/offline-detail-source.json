        }
      ]
    },
    {
      "id": "offline-detail-source.no-download-unreachable-explains",
      "note": "Not downloaded and the server out of reach: unavailable, with the reason on the page.",
      "operation": "detail-source",
      "state": {},
      "steps": [
        {
          "event": {
            "ready": false,
