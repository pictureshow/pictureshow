{
  "schemaVersion": 1,
  "suite": "offline-detail-source",
  "cases": [
    {
      "id": "offline-detail-source.ready-plays-local-online",
      "note": "A ready download plays on its own page even with the server answering: no data spent on a copy already here.",
      "operation": "detail-source",
      "state": {},
      "steps": [
        {
          "event": {
            "ready": true,
            "server": "reachable",
            "explicitStream": false
          },
          "expected": {
            "source": "local"
          }
        }
      ]
    },
    {
      "id": "offline-detail-source.ready-plays-local-unreachable",
      "note": "The plane case: server out of reach, the page's Play uses the download.",
      "operation": "detail-source",
      "state": {},
      "steps": [
        {
          "event": {
            "ready": true,
            "server": "unreachable",
            "explicitStream": false
          },
          "expected": {
            "source": "local"
          }
        }
      ]
    },
    {
      "id": "offline-detail-source.ready-plays-local-unknown",
      "note": "Nothing has failed yet: the download still plays, with no wait for a server check.",
      "operation": "detail-source",
      "state": {},
      "steps": [
        {
          "event": {
            "ready": true,
            "server": "unknown",
            "explicitStream": false
          },
          "expected": {
            "source": "local"
          }
        }
      ]
    },
    {
      "id": "offline-detail-source.stream-instead-is-deliberate",
      "note": "Stream from server instead, with the server answering, streams.",
      "operation": "detail-source",
      "state": {},
      "steps": [
        {
          "event": {
            "ready": true,
            "server": "reachable",
            "explicitStream": true
          },
          "expected": {
            "source": "stream"
          }
        }
      ]
    },
    {
      "id": "offline-detail-source.stream-instead-unknown-tries",
      "note": "Stream instead with reachability unknown tries the server; the player reports a failure.",
      "operation": "detail-source",
      "state": {},
      "steps": [
        {
          "event": {
            "ready": true,
            "server": "unknown",
            "explicitStream": true
          },
          "expected": {
            "source": "stream"
          }
        }
      ]
    },
    {
      "id": "offline-detail-source.stream-instead-unreachable-explains",
      "note": "Stream instead with the server out of reach is unavailable and says why, rather than opening a player that can only fail.",
      "operation": "detail-source",
      "state": {},
      "steps": [
        {
          "event": {
            "ready": true,
            "server": "unreachable",
            "explicitStream": true
          },
          "expected": {
            "source": "unavailable"
          }
        }
      ]
    },
    {
      "id": "offline-detail-source.no-download-streams",
      "note": "Not downloaded: Play streams as always.",
      "operation": "detail-source",
      "state": {},
      "steps": [
        {
          "event": {
            "ready": false,
            "server": "reachable",
            "explicitStream": false
          },
          "expected": {
            "source": "stream"
          }
        }
      ]
    },
    {
      "id": "offline-detail-source.no-download-unknown-tries",
      "note": "Not downloaded, nothing failed yet: try the server.",
      "operation": "detail-source",
      "state": {},
      "steps": [
        {
          "event": {
            "ready": false,
            "server": "unknown",
            "explicitStream": false
          },
          "expected": {
