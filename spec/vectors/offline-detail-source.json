        }
      ]
    },
    {
      "id": "offline-detail-source.start-from-start",
      "note": "Play from start is zero whatever is known.",
      "operation": "detail-start",
      "state": {},
      "steps": [
        {
          "event": {
            "fromStart": true,
            "outbox": {
              "server": "srv",
              "viewer": "u1",
              "itemId": "i1",
              "base": {
                "positionTicks": "100",
                "played": false,
                "playCount": 0,
                "lastPlayedDate": null
              },
              "sequence": "1",
              "positionTicks": "500",
              "played": null,
              "phase": "dirty",
              "conflict": null,
              "writing": null
            },
            "lastKnown": {
              "positionTicks": "100",
              "played": false,
              "playCount": 0,
              "lastPlayedDate": null
            },
            "server": {
              "positionTicks": "900",
              "played": false,
              "playCount": 0,
              "lastPlayedDate": null
            }
          },
          "expected": {
            "startTicks": "0"
          }
        }
      ]
    },
