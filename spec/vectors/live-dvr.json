{
  "schemaVersion": 1,
  "suite": "live-dvr",
  "sources": [
    "core/src/commonMain/kotlin/app/pictureshow/core/livetv/LiveRules.kt",
    "core/src/commonMain/kotlin/app/pictureshow/core/livetv/LiveTvClient.kt"
  ],
  "cases": [
    {
      "id": "live-dvr.oneoff-projects-series-defaults-with-provider-common-fields",
      "operation": "draft",
      "input": {
        "defaults": {
          "Id": "default",
          "ProgramId": "old",
          "ChannelId": "old",
          "Name": "Default",
          "StartDate": "old",
          "EndDate": "old",
          "ServiceName": "Emby",
          "ExternalProgramId": "provider-id",
          "PrePaddingSeconds": 20,
          "PostPaddingSeconds": 30,
          "Priority": 2,
          "KeepUntil": "UntilDeleted",
          "RecordNewOnly": true,
          "RecordAnyChannel": false,
          "Days": [
            "Monday"
          ],
          "ProviderExtension": {
            "keep": true
          }
        },
        "program": {
          "Id": "p",
          "Name": "Program",
          "ChannelId": "c",
          "StartDate": "2030-11-03T05:00:00Z",
          "EndDate": "2030-11-03T07:00:00Z"
        },
        "series": false
      },
      "expected": {
        "ProgramId": "p",
        "ChannelId": "c",
        "Name": "Program",
        "StartDate": "2030-11-03T05:00:00Z",
        "EndDate": "2030-11-03T07:00:00Z",
        "ServiceName": "Emby",
        "ExternalProgramId": "provider-id",
        "PrePaddingSeconds": 20,
        "PostPaddingSeconds": 30,
        "Priority": 2,
        "KeepUntil": "UntilDeleted"
      }
    },
