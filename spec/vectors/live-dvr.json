    {
      "id": "live-dvr.statuses-are-server-facts",
      "operation": "statuses",
      "input": {
        "statuses": [
          "New",
          "InProgress",
          "Completed",
          "Cancelled",
          "ConflictedOk",
          "ConflictedNotOk",
          "Error",
          "FutureState"
        ]
      },
      "expected": [
        "Scheduled",
        "Recording now",
        "Completed",
        "Cancelled",
        "Conflict accepted by server",
        "Conflict rejected by server",
        "Recording error",
        "Unknown status (FutureState)"
      ]
    },
    {
      "id": "live-dvr.ambiguous-accepted-create-is-read-back",
      "operation": "create-trace",
      "input": {
        "draft": {
          "ProgramId": "p",
          "ChannelId": "c",
          "Name": "Program",
          "StartDate": "2030-11-03T05:00:00Z",
          "EndDate": "2030-11-03T07:00:00Z",
          "ServiceName": "Emby",
          "ExternalProgramId": "provider-id",
          "PrePaddingSeconds": 20,
          "PostPaddingSeconds": 30,
          "Priority": 2,
          "KeepUntil": "UntilDeleted"
        },
        "policy": {
          "EnableLiveTvAccess": true,
          "EnableLiveTvManagement": true,
          "EnableContentDeletion": true,
          "EnableUserPreferenceAccess": true
        },
        "applied": true,
        "disconnect": true,
        "series": false
      },
      "expected": {
        "first": "ok",
        "second": "ok",
        "postCount": 1,
        "posts": [
          "POST /LiveTv/Timers"
        ]
      }
    },
