  {
   "id": "offline-reconnect.refusals-in-order",
   "operation": "reconnect-decision",
   "state": {},
   "steps": [
    {
     "event": {
      "trackSwitch": "reconnect",
      "network": "unmetered",
      "server": "unreachable",
      "playbackAllowed": true,
      "trackOnServer": true
     },
     "expected": {
      "outcome": "server-unreachable"
     }
    },
    {
     "event": {
      "trackSwitch": "reconnect",
      "network": "unmetered",
      "server": "signed-out",
      "playbackAllowed": true,
      "trackOnServer": true
     },
     "expected": {
      "outcome": "signed-out"
     }
    },
    {
     "event": {
      "trackSwitch": "reconnect",
      "network": "unmetered",
      "server": "ok",
      "playbackAllowed": false,
      "trackOnServer": false
     },
     "expected": {
      "outcome": "not-allowed"
     }
    },
    {
     "event": {
      "trackSwitch": "reconnect",
      "network": "unmetered",
      "server": "ok",
      "playbackAllowed": false
     },
     "expected": {
      "outcome": "not-allowed"
     }
    },
    {
     "event": {
      "trackSwitch": "reconnect",
      "network": "unmetered",
      "server": "ok",
      "playbackAllowed": true,
      "trackOnServer": false
     },
     "expected": {
      "outcome": "track-gone"
     }
    }
   ]
  },
