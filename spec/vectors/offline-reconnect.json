  {
   "id": "offline-reconnect.a-local-track-is-never-a-reconnect",
   "operation": "reconnect-decision",
   "state": {},
   "steps": [
    {
     "event": {
      "trackSwitch": "local",
      "network": "none"
     },
     "expected": {
      "outcome": "local",
      "metered": false
     }
    },
    {
     "event": {
      "trackSwitch": "local",
      "network": "metered",
      "server": "ok",
      "playbackAllowed": true,
      "trackOnServer": true
     },
     "expected": {
      "outcome": "local",
      "metered": false
     }
    }
   ]
  },
