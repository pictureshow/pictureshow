{
  "schemaVersion": 1,
  "suite": "playback-info-reasons",
  "cases": [
    {
      "id": "playback-info-reasons.unreported-scaling",
      "input": {
        "method": "Transcode",
        "reasons": [],
        "source": {
          "MediaStreams": [
            {
              "Type": "Video",
              "Codec": "hevc",
              "Profile": "Main 10",
              "Width": 3840,
              "Height": 2160
            },
            {
              "Type": "Audio",
              "Codec": "truehd",
              "Index": 1
            }
          ],
          "DefaultAudioStreamIndex": 1
        },
        "received": {
          "width": 960,
          "height": 540,
          "codec": "hevc"
        },
        "receiverAudio": false
      },
      "expected": [
        "Scaled from 3840\u00d72160 to 960\u00d7540 during playback. The server did not report a resolution reason."
      ]
    },
    {
      "id": "playback-info-reasons.server-covers-scaling",
      "input": {
        "method": "Transcode",
        "reasons": [
          "VideoResolutionNotSupported"
        ],
        "source": {
          "MediaStreams": [
            {
              "Type": "Video",
              "Codec": "hevc",
              "Profile": "Main 10",
              "Width": 3840,
              "Height": 2160
            },
            {
              "Type": "Audio",
              "Codec": "truehd",
              "Index": 1
            }
          ],
          "DefaultAudioStreamIndex": 1
        },
        "received": {
          "width": 960,
          "height": 540
        },
        "receiverAudio": false
      },
      "expected": [
        "This video's resolution exceeds this device's limit. The server reduces the resolution."
      ]
    },
    {
