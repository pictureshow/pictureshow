{
  "schemaVersion": 1,
  "suite": "sync-clock",
  "cases": [
    {
      "id": "clock-processing-positive",
      "op": "sample",
      "input": [
        1000,
        1120,
        1130,
        1050
      ],
      "expected": {
        "rtt": 40,
        "offsetTicks": 1000000,
        "uncertaintyTicks": 200000
      }
    },
    {
      "id": "clock-negative-offset",
      "op": "sample",
      "input": [
        1000,
        920,
        930,
        1050
      ],
      "expected": {
        "rtt": 40,
        "offsetTicks": -1000000,
        "uncertaintyTicks": 200000
      }
    },
    {
      "id": "clock-half-ms",
      "op": "sample",
      "input": [
        0,
        1,
        1,
        1
      ],
      "expected": {
        "rtt": 1,
        "offsetTicks": 5000,
        "uncertaintyTicks": 5000
      }
    },
    {
      "id": "clock-negative-rtt",
      "op": "sample",
      "input": [
        0,
        1,
        12,
        10
      ],
      "expected": null
    },
    {
      "id": "clock-too-slow",
      "op": "sample",
      "input": [
        0,
        0,
        0,
        1001
      ],
      "expected": null
    },
    {
      "id": "clock-max-rtt",
      "op": "sample",
      "input": [
        0,
        0,
        0,
        1000
      ],
      "expected": {
        "rtt": 1000,
        "offsetTicks": -5000000,
        "uncertaintyTicks": 5000000
      }
    },
