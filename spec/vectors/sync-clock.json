{
  "schemaVersion": 1,
  "suite": "sync-clock",
  "cases": [
    {
      "id": "clock-processing-positive",
      "op": "sample",
      "input": [
        1000,
        1120,
        1130,
        1050
      ],
      "expected": {
        "rtt": 40,
        "offsetTicks": 1000000,
        "uncertaintyTicks": 200000
      }
    },
    {
      "id": "clock-negative-offset",
      "op": "sample",
      "input": [
        1000,
        920,
        930,
        1050
      ],
      "expected": {
        "rtt": 40,
        "offsetTicks": -1000000,
        "uncertaintyTicks": 200000
      }
    },
    {
      "id": "clock-half-ms",
      "op": "sample",
      "input": [
        0,
        1,
        1,
        1
      ],
      "expected": {
        "rtt": 1,
        "offsetTicks": 5000,
        "uncertaintyTicks": 5000
      }
    },
    {
      "id": "clock-negative-rtt",
      "op": "sample",
      "input": [
        0,
        1,
        12,
        10
      ],
      "expected": null
    },
    {
      "id": "clock-too-slow",
      "op": "sample",
      "input": [
        0,
        0,
        0,
        1001
      ],
      "expected": null
    },
    {
      "id": "clock-max-rtt",
      "op": "sample",
      "input": [
        0,
        0,
        0,
        1000
      ],
      "expected": {
        "rtt": 1000,
        "offsetTicks": -5000000,
        "uncertaintyTicks": 5000000
      }
    },
    {
      "id": "clock-backward-server",
      "op": "sample",
      "input": [
        0,
        12,
        1,
        20
      ],
      "expected": null
    },
    {
      "id": "clock-overflow",
      "op": "sample",
      "input": [
        -9223372036854775808,
        0,
        0,
        9223372036854775807
      ],
      "expected": null
    },
    {
      "id": "target-future",
      "op": "target",
      "input": {
        "position": "50000000",
        "when": 1100,
        "now": "10000000",
        "playing": true,
        "duration": "100000000"
      },
      "expected": {
        "position": "50000000",
        "delay": 100
      }
    },
    {
      "id": "target-late-playing",
      "op": "target",
      "input": {
        "position": "50000000",
        "when": 1000,
        "now": "11000000",
        "playing": true,
        "duration": "100000000"
      },
      "expected": {
        "position": "51000000",
        "delay": 0
      }
    },
    {
      "id": "target-late-paused",
      "op": "target",
      "input": {
        "position": "50000000",
        "when": 1000,
        "now": "11000000",
        "playing": false,
        "duration": "100000000"
      },
      "expected": {
        "position": "50000000",
        "delay": 0
      }
    },
    {
      "id": "target-bounds",
      "op": "target",
      "input": {
        "position": "9223372036854775700",
        "when": 1000,
        "now": "11000000",
        "playing": true,
        "duration": "9223372036854775807"
      },
      "expected": {
        "position": "9223372036854775807",
        "delay": 0
      }
    },
    {
      "id": "target-fractional-future",
      "op": "target",
      "input": {
        "position": "0",
        "when": 1001,
        "now": "10000001",
        "playing": true,
        "duration": "100000000"
      },
      "expected": {
        "position": "0",
        "delay": 1
      }
    },
    {
      "id": "scheduled-zero",
      "op": "scheduled-position",
      "input": {
        "command": "Unpause",
        "current": "0",
        "target": "0"
      },
      "expected": null
    },
    {
      "id": "scheduled-ahead80",
      "op": "scheduled-position",
      "input": {
        "command": "Unpause",
        "current": "1800000",
        "target": "1000000"
      },
      "expected": null
    },
    {
      "id": "scheduled-behind80",
      "op": "scheduled-position",
      "input": {
        "command": "Unpause",
        "current": "200000",
        "target": "1000000"
      },
      "expected": null
    },
    {
      "id": "scheduled-ahead-outside",
      "op": "scheduled-position",
      "input": {
        "command": "Unpause",
        "current": "1800001",
        "target": "1000000"
      },
      "expected": "1000000"
    },
    {
      "id": "scheduled-behind-outside",
      "op": "scheduled-position",
      "input": {
        "command": "Unpause",
        "current": "199999",
        "target": "1000000"
      },
      "expected": "1000000"
    },
    {
      "id": "scheduled-pause-small",
      "op": "scheduled-position",
      "input": {
        "command": "Pause",
        "current": "1020000",
        "target": "1000000"
      },
      "expected": "1000000"
    },
    {
      "id": "scheduled-seek-small",
      "op": "scheduled-position",
      "input": {
        "command": "Seek",
        "current": "1020000",
        "target": "1000000"
      },
      "expected": "1000000"
    },
    {
      "id": "scheduled-invalid-current",
      "op": "scheduled-position",
      "input": {
        "command": "Unpause",
        "current": "-1",
        "target": "0"
      },
      "expected": "0"
    },
    {
      "id": "scheduled-large-ticks",
      "op": "scheduled-position",
      "input": {
        "command": "Unpause",
        "current": "9223372036854775807",
        "target": "0"
      },
      "expected": "0"
    },
    {
      "id": "scheduled-large-target",
      "op": "scheduled-position",
      "input": {
        "command": "Unpause",
        "current": "0",
        "target": "9223372036854775807"
      },
      "expected": "9223372036854775807"
    },
    {
      "id": "timeline-paused-seek",
      "op": "timeline-playing",
      "input": {
        "command": "Seek",
        "appliedPlaying": false
      },
      "expected": false
    },
    {
      "id": "timeline-playing-seek",
      "op": "timeline-playing",
      "input": {
        "command": "Seek",
        "appliedPlaying": true
      },
      "expected": true
    },
    {
      "id": "timeline-unpause",
      "op": "timeline-playing",
      "input": {
        "command": "Unpause",
        "appliedPlaying": false
      },
      "expected": true
    },
    {
      "id": "timeline-pause",
      "op": "timeline-playing",
      "input": {
        "command": "Pause",
        "appliedPlaying": true
      },
      "expected": false
    }
  ]
}
