{
  "schemaVersion": 1,
  "suite": "sync-clock",
  "cases": [
    {
      "id": "clock-processing-positive",
      "op": "sample",
      "input": [
        1000,
        1120,
        1130,
        1050
      ],
      "expected": {
        "rtt": 40,
        "offsetTicks": 1000000,
        "uncertaintyTicks": 200000
      }
    },
    {
      "id": "clock-negative-offset",
      "op": "sample",
      "input": [
        1000,
        920,
        930,
        1050
      ],
      "expected": {
        "rtt": 40,
        "offsetTicks": -1000000,
        "uncertaintyTicks": 200000
      }
    },
    {
      "id": "clock-half-ms",
      "op": "sample",
      "input": [
        0,
        1,
        1,
        1
      ],
      "expected": {
        "rtt": 1,
        "offsetTicks": 5000,
        "uncertaintyTicks": 5000
      }
    },
    {
      "id": "clock-negative-rtt",
      "op": "sample",
      "input": [
        0,
        1,
        12,
        10
      ],
      "expected": null
    },
    {
      "id": "clock-too-slow",
      "op": "sample",
      "input": [
        0,
        0,
        0,
        1001
      ],
      "expected": null
    },
    {
      "id": "clock-max-rtt",
      "op": "sample",
      "input": [
        0,
        0,
        0,
        1000
      ],
      "expected": {
        "rtt": 1000,
        "offsetTicks": -5000000,
        "uncertaintyTicks": 5000000
      }
    },
    {
      "id": "clock-backward-server",
      "op": "sample",
      "input": [
        0,
        12,
        1,
        20
      ],
      "expected": null
    },
    {
      "id": "clock-overflow",
      "op": "sample",
      "input": [
        -9223372036854775808,
        0,
        0,
        9223372036854775807
      ],
      "expected": null
    },
    {
      "id": "target-future",
      "op": "target",
      "input": {
        "position": "50000000",
        "when": 1100,
        "now": "10000000",
        "playing": true,
        "duration": "100000000"
      },
      "expected": {
        "position": "50000000",
        "delay": 100
      }
    },
    {
      "id": "target-late-playing",
      "op": "target",
      "input": {
        "position": "50000000",
        "when": 1000,
        "now": "11000000",
        "playing": true,
        "duration": "100000000"
      },
      "expected": {
        "position": "51000000",
        "delay": 0
      }
    },
    {
      "id": "target-late-paused",
      "op": "target",
      "input": {
        "position": "50000000",
        "when": 1000,
        "now": "11000000",
        "playing": false,
        "duration": "100000000"
      },
      "expected": {
        "position": "50000000",
        "delay": 0
      }
    },
    {
      "id": "target-bounds",
      "op": "target",
      "input": {
        "position": "9223372036854775700",
        "when": 1000,
        "now": "11000000",
        "playing": true,
        "duration": "9223372036854775807"
      },
      "expected": {
        "position": "9223372036854775807",
        "delay": 0
      }
    },
    {
      "id": "target-fractional-future",
      "op": "target",
      "input": {
        "position": "0",
        "when": 1001,
        "now": "10000001",
        "playing": true,
        "duration": "100000000"
      },
      "expected": {
        "position": "0",
        "delay": 1
      }
    }
  ]
}
