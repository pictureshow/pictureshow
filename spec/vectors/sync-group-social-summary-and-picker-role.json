      "expected": {
        "countSnapshots": [
          {
            "count": 0,
            "countText": "0 people watching"
          },
          {
            "count": 1,
            "countText": "1 person watching"
          },
          {
            "count": 2,
            "countText": "2 people watching"
          },
          {
            "count": 0,
            "countText": "0 people watching"
          }
        ],
        "wholeCountAboveFooterOnArrival": true,
        "rescueScroll": false,
        "previousDistinctCountAbsent": true,
        "groupCommands": 0
      }
    },
