{
  "schemaVersion": 1,
  "suite": "sync-group-social-summary-and-picker-role",
  "scope": "Native group first-arrival social count and actual remote versus media chooser role. No inferred named readiness, self identity, receiver selection or output qualification.",
  "cases": [
    {
      "id": "phone-empty-one-person",
      "input": {
        "platform": "touch",
        "widthDp": 360,
        "heightDp": 640,
        "fontScale": 1.0,
        "phase": "Idle",
        "queueEntries": 0,
        "participants": [
          "Morgan"
        ]
      },
      "expected": {
        "countText": "1 person watching",
        "wholeCountAboveFooterOnArrival": true,
        "rescueScroll": false,
        "groupCommands": 0
      }
    },
    {
      "id": "phone-empty-two-people-large-font",
      "input": {
        "platform": "touch",
        "widthDp": 360,
        "heightDp": 640,
        "fontScale": 1.3,
        "phase": "Idle",
        "queueEntries": 0,
        "participants": [
          "Morgan",
          "Sam"
        ]
      },
      "expected": {
        "countText": "2 people watching",
        "wholeCountAboveFooterOnArrival": true,
        "rescueScroll": false,
        "groupCommands": 0
      }
    },
    {
      "id": "remote-only-picker",
      "input": {
        "request": "remote-control",
        "mediaRequestPresent": false
      },
      "expected": {
        "dialogTitle": "Choose a TV",
        "titleIsHeading": true,
        "thisDeviceOption": false
      }
    },
    {
      "id": "media-play-picker",
      "input": {
        "request": "play-media",
        "mediaRequestPresent": true
      },
      "expected": {
        "dialogTitle": "Play on",
        "titleIsHeading": true
      }
    },
    {
      "id": "phone-empty-count-snapshot-lifecycle",
      "input": {
        "platform": "touch",
        "widthDp": 360,
        "heightDp": 640,
        "fontScale": 1.3,
        "phase": "Idle",
        "queueEntries": 0,
        "participantSnapshots": [
          [],
          [
            "Morgan"
          ],
          [
            "Morgan",
            "Sam"
          ],
          []
        ]
      },
      "expected": {
        "countSnapshots": [
          {
            "count": 0,
            "countText": "0 people watching"
          },
          {
            "count": 1,
            "countText": "1 person watching"
          },
          {
            "count": 2,
            "countText": "2 people watching"
          },
          {
            "count": 0,
            "countText": "0 people watching"
          }
        ],
        "wholeCountAboveFooterOnArrival": true,
        "rescueScroll": false,
        "previousDistinctCountAbsent": true,
        "groupCommands": 0
      }
    },
    {
      "id": "tv-joined-name-count-first-baseline-font10",
      "input": {
        "platform": "tv",
        "widthPx": 960,
        "heightPx": 540,
        "densityDpi": 156,
        "fontScale": 1.0,
        "groupName": "Friday films",
        "participants": [
          "Morgan",
          "Sam"
        ],
        "phase": "Idle",
        "queueEntries": 0
      },
      "expected": {
        "baselineToleranceNativePx": 1,
        "firstUsefulFocus": "ignore-wait",
        "passive": true,
        "groupCommands": 0
      }
    },
    {
      "id": "tv-joined-name-count-first-baseline-font13",
      "input": {
        "platform": "tv",
        "widthPx": 960,
        "heightPx": 540,
        "densityDpi": 156,
        "fontScale": 1.3,
        "groupName": "Friday films",
        "participants": [
          "Morgan",
