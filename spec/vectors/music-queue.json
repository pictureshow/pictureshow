{
  "schemaVersion": 1,
  "suite": "music-queue",
  "cases": [
    {
      "id": "music-queue.selected-track-keeps-its-context",
      "operation": "queue",
      "state": {
        "server": "s",
        "viewer": "v"
      },
      "steps": [
        {
          "event": {
            "op": "play-now",
            "revision": "0",
            "entries": [
              {
                "id": "a",
                "media": "song-a"
              },
              {
                "id": "b",
                "media": "song-b"
              },
              {
                "id": "c",
                "media": "song-c"
              },
              {
                "id": "d",
                "media": "song-d"
              }
            ],
            "entry": "c"
          },
          "expected": {
            "queue": {
              "order": [
                "a",
                "b",
                "c",
                "d"
              ],
              "current": "c",
              "visited": [
                "a",
                "b"
              ],
              "history": [],
              "paused": false,
              "shuffled": false
            },
            "outcome": "changed"
          }
        },
        {
          "event": {
            "op": "previous",
            "revision": "1"
          },
          "expected": {
            "queue": {
              "current": "b"
            },
            "outcome": "changed"
          }
        }
      ]
    },
