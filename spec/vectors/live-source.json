{
  "suite": "live-source",
  "schemaVersion": 1,
  "description": "Live playback uses observed player windows, never scheduled program durations. Pause expiry does not imply a resume.",
  "cases": [
    {
      "id": "actual-edge",
      "window": {
        "offsetMs": 100000,
        "durationMs": 30000,
        "defaultPositionMs": 27000,
        "seekable": true
      },
      "positionMs": 30000,
      "pausedAbsoluteMs": null,
      "expected": {
        "canTimeShift": true,
        "contains": true,
        "expired": false,
        "goLiveMs": 27000,
        "behindLiveMs": 0,
        "atLiveEdge": true
      }
    },
    {
      "id": "reject-guide-duration",
      "window": {
        "offsetMs": 100000,
        "durationMs": 30000,
        "defaultPositionMs": 27000,
        "seekable": true
      },
