      "pausedAbsoluteMs": null,
      "expected": {
        "canTimeShift": true,
        "contains": false,
        "expired": false,
        "goLiveMs": 27000,
        "behindLiveMs": null,
        "atLiveEdge": false
      }
    },
    {
