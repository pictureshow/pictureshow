        "defaultPositionMs": 27000,
        "seekable": true
      },
      "positionMs": 0,
      "pausedAbsoluteMs": 119999,
      "expected": {
        "canTimeShift": true,
        "contains": true,
        "expired": true,
        "goLiveMs": 27000,
        "behindLiveMs": 27000,
        "atLiveEdge": false
      }
    },
    {
