{
  "schemaVersion": 1,
  "suite": "live-presentation",
  "sources": [
    "app/src/main/kotlin/app/pictureshow/LiveGuide.kt",
    "app/src/main/kotlin/app/pictureshow/LiveTime.kt"
  ],
  "cases": [
    {
      "id": "live-presentation.ruler-start",
      "operation": "tick",
      "input": {
        "tick": 0
      },
      "expected": 0
    },
    {
      "id": "live-presentation.ruler-half-hour",
      "operation": "tick",
      "input": {
        "tick": 1
      },
      "expected": 180
    },
    {
      "id": "live-presentation.ruler-hour",
      "operation": "tick",
      "input": {
        "tick": 2
      },
      "expected": 360
    },
    {
      "id": "live-presentation.ruler-end",
      "operation": "tick",
      "input": {
        "tick": 6
      },
      "expected": 1080
    },
    {
      "id": "live-presentation.sliver-no-glyphs",
      "operation": "text",
      "input": {
        "width": 2
      },
      "expected": false
    },
    {
      "id": "live-presentation.short-slot-no-glyphs",
      "operation": "text",
      "input": {
        "width": 48
      },
      "expected": false
    },
    {
      "id": "live-presentation.text-threshold",
      "operation": "text",
      "input": {
        "width": 72
      },
      "expected": true
    },
    {
      "id": "live-presentation.regular-slot-title",
      "operation": "text",
      "input": {
        "width": 240
      },
      "expected": true
    },
    {
      "id": "live-presentation.device-twelve-hour",
      "operation": "clock",
      "input": {
        "twentyFour": false,
        "instant": "2026-11-10T20:14:00Z",
        "locale": "en-US",
        "zone": "America/New_York",
        "now": "2026-11-10T18:00:00Z"
      },
      "expected": "3:14 PM"
    },
    {
      "id": "live-presentation.device-twenty-four-hour",
      "operation": "clock",
      "input": {
        "twentyFour": true,
        "instant": "2026-11-10T20:14:00Z",
        "locale": "en-US",
        "zone": "America/New_York",
        "now": "2026-11-10T18:00:00Z"
      },
      "expected": "15:14"
    },
    {
      "id": "live-presentation.dst-first-fold",
      "operation": "clock",
      "input": {
        "twentyFour": false,
        "instant": "2026-11-01T05:30:00Z",
        "locale": "en-US",
        "zone": "America/New_York",
        "now": "2026-11-10T18:00:00Z"
      },
      "expected": "1:30 AM -04:00"
    },
    {
      "id": "live-presentation.dst-second-fold",
      "operation": "clock",
      "input": {
        "twentyFour": false,
        "instant": "2026-11-01T06:30:00Z",
        "locale": "en-US",
        "zone": "America/New_York",
        "now": "2026-11-10T18:00:00Z"
      },
      "expected": "1:30 AM -05:00"
    },
    {
      "id": "live-presentation.after-fold-no-offset",
      "operation": "clock",
      "input": {
        "twentyFour": true,
        "instant": "2026-11-01T07:30:00Z",
        "locale": "en-US",
        "zone": "America/New_York",
        "now": "2026-11-10T18:00:00Z"
      },
      "expected": "02:30"
    },
    {
      "id": "live-presentation.same-day-concise-range",
      "operation": "range",
      "input": {
        "twentyFour": false,
        "start": "2026-11-10T20:14:00Z",
        "end": "2026-11-10T20:42:00Z",
        "locale": "en-US",
        "zone": "America/New_York",
        "now": "2026-11-10T18:00:00Z"
      },
      "expected": "3:14 \u2013 3:42 PM"
    },
    {
      "id": "live-presentation.period-crossing-range",
      "operation": "range",
      "input": {
        "twentyFour": false,
        "start": "2026-11-10T16:55:00Z",
        "end": "2026-11-10T17:10:00Z",
        "locale": "en-US",
        "zone": "America/New_York",
        "now": "2026-11-10T18:00:00Z"
      },
      "expected": "11:55 AM \u2013 12:10 PM"
    },
    {
      "id": "live-presentation.tomorrow-range",
      "operation": "range",
      "input": {
        "twentyFour": true,
        "start": "2026-11-11T20:00:00Z",
        "end": "2026-11-11T21:00:00Z",
        "locale": "en-US",
        "zone": "America/New_York",
        "now": "2026-11-10T18:00:00Z"
      },
      "expected": "Tomorrow \u00b7 15:00 \u2013 16:00"
    },
    {
      "id": "live-presentation.no-timer-dot",
      "operation": "recording-dot",
      "input": {
        "timerId": null,
        "seriesTimerId": null
      },
      "expected": false
    },
    {
      "id": "live-presentation.blank-timer-dot",
      "operation": "recording-dot",
      "input": {
        "timerId": "",
        "seriesTimerId": null
      },
      "expected": false
    },
    {
      "id": "live-presentation.series-rule-is-not-an-occurrence",
      "operation": "recording-dot",
      "input": {
        "timerId": null,
        "seriesTimerId": "series-rule"
      },
      "expected": false
    },
    {
      "id": "live-presentation.scheduled-occurrence-dot",
      "operation": "recording-dot",
      "input": {
        "timerId": "timer",
        "seriesTimerId": "series-rule"
      },
      "expected": true
    }
  ]
}
