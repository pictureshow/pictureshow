{
  "schemaVersion": 1,
  "suite": "music-session",
  "cases": [
    {
      "id": "music-session.call-interrupts-and-resumes",
      "operation": "session",
      "state": {
        "intent": "play"
      },
      "steps": [
        {
          "event": {
            "op": "interrupted"
          },
          "expected": {
            "intent": "play",
            "interrupted": true,
            "effect": "pause"
          }
        },
        {
          "event": {
            "op": "interruption-ended"
          },
          "expected": {
            "intent": "play",
            "interrupted": false,
            "effect": "play"
          }
        }
      ]
    },
    {
      "id": "music-session.viewer-pause-during-interruption-stays-paused",
      "operation": "session",
      "state": {
        "intent": "play"
      },
      "steps": [
        {
          "event": {
            "op": "interrupted"
          },
          "expected": {
            "effect": "pause"
          }
        },
        {
          "event": {
            "op": "viewer-pause"
          },
          "expected": {
            "intent": "pause",
            "effect": "pause"
          }
        },
        {
          "event": {
            "op": "interruption-ended"
          },
          "expected": {
            "intent": "pause",
            "interrupted": false,
            "effect": "none"
          }
        }
      ]
    },
    {
      "id": "music-session.duplicate-interruption-acts-once",
      "operation": "session",
      "state": {
        "intent": "play"
      },
      "steps": [
        {
          "event": {
            "op": "interrupted"
          },
          "expected": {
            "effect": "pause"
          }
        },
        {
          "event": {
            "op": "interrupted"
          },
          "expected": {
            "effect": "none"
          }
        }
      ]
    },
    {
      "id": "music-session.focus-lost-stays-paused",
      "operation": "session",
      "state": {
        "intent": "play"
      },
      "steps": [
        {
          "event": {
            "op": "focus-lost"
          },
          "expected": {
            "intent": "pause",
            "effect": "pause"
          }
        },
        {
          "event": {
            "op": "interruption-ended"
          },
          "expected": {
            "effect": "none",
            "intent": "pause"
          }
        }
      ]
    },
    {
      "id": "music-session.headphones-out-pauses-and-back-in-stays-quiet",
      "operation": "session",
      "state": {
        "intent": "play"
      },
      "steps": [
        {
          "event": {
            "op": "noisy"
          },
          "expected": {
            "intent": "pause",
            "effect": "pause"
          }
        },
        {
          "event": {
            "op": "route-connected"
          },
          "expected": {
            "intent": "pause",
            "effect": "none"
          }
        }
      ]
    },
    {
      "id": "music-session.noisy-while-paused-does-nothing",
      "operation": "session",
      "state": {
        "intent": "play"
      },
      "steps": [
        {
          "event": {
            "op": "viewer-pause"
          },
          "expected": {
            "effect": "pause"
          }
        },
        {
          "event": {
            "op": "noisy"
          },
          "expected": {
            "intent": "pause",
            "effect": "none"
          }
        }
      ]
    },
    {
      "id": "music-session.duck-leaves-intent",
      "operation": "session",
      "state": {
        "intent": "play"
      },
      "steps": [
        {
          "event": {
            "op": "duck"
          },
          "expected": {
            "intent": "play",
            "ducked": true,
            "effect": "none"
          }
        },
        {
          "event": {
            "op": "unduck"
          },
          "expected": {
            "ducked": false,
            "effect": "none"
          }
        }
      ]
    },
    {
      "id": "music-session.video-stops-audio-once-keeping-the-queue",
      "operation": "session",
      "state": {
        "intent": "play"
      },
      "steps": [
        {
          "event": {
            "op": "video-start"
          },
          "expected": {
            "intent": "stopped",
            "effect": "stop-keep"
          }
        },
        {
          "event": {
            "op": "video-start"
          },
          "expected": {
            "intent": "stopped",
            "effect": "none"
          }
        }
      ]
    },
    {
      "id": "music-session.stop-keeps-queue",
