    {
      "id": "music-session.same-key-press-acts-once",
      "operation": "session",
      "state": {
        "intent": "play"
      },
      "steps": [
        {
          "event": {
            "op": "key",
            "key": "85@100"
          },
          "expected": {
            "effect": "accept"
          }
        },
        {
          "event": {
            "op": "key",
            "key": "85@100"
          },
          "expected": {
            "effect": "ignore"
          }
        },
        {
          "event": {
            "op": "key",
            "key": "85@200"
          },
          "expected": {
            "effect": "accept"
          }
        }
      ]
    },
