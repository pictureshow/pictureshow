{
  "name": "pictureshow-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "node tests/generate-media.mjs && playwright test",
    "test:vectors": "vitest run --config vitest.vectors.config.ts",
    "test:media": "node tests/generate-media.mjs",
    "format": "prettier --write src core tests *.ts",
    "tokens": "node scripts/generate-tokens.mjs",
    "test:firefox:linux": "sh scripts/test-firefox-linux.sh"
  },
  "dependencies": {
    "@pictureshow/core": "file:core",
    "hls.js": "1.7.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "axe-core": "4.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
