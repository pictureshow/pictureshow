<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" tools:node="remove" />
    <queries>
        <provider android:authorities="android.media.tv" tools:node="remove" />
        <intent tools:node="remove">
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="play.google.com" />
        </intent>
    </queries>
    <application>
        <meta-data android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME" tools:node="remove" />
    </application>
</manifest>
